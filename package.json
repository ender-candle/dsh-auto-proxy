{
  "name": "dsh-auto-proxy",
  "version": "0.2.0",
  "description": "Three-switch network proxy for DeepSeek Harness: proxy search, LLM and general web traffic independently, and drop to a direct connection the moment the system proxy is turned off.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "agent",
    "proxy",
    "system-proxy",
    "network-proxy",
    "http-proxy",
    "socks5",
    "network",
    "windows",
    "web-search",
    "llm",
    "plugin"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node test/unit.test.mjs",
    "test:e2e": "node test/tunnel.e2e.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "react"
      ]
    },
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    }
  }
}
